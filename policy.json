{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::parcial2-backup-bucket",
        "arn:aws:s3:::parcial2-backup-bucket/*"
      ]
    }
  ]
}